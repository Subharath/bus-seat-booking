# Copy these to Vercel Environment Variables
# Settings → Environment Variables → Add each one

# === DATABASE ===
DATABASE_URL=postgresql://user:pass@host.region.provider.tech/dbname?sslmode=require

# === AUTHENTICATION ===
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-characters

# === APPLICATION URLS ===
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://your-project-name.vercel.app

# === PAYHERE PAYMENT GATEWAY ===
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX_URL=https://sandbox.payhere.lk/pay/checkout

# ⚠️ IMPORTANT NOTES:
# 1. DATABASE_URL: Use connection pooling URL (not direct connection)
#    - Neon: Already pooled by default
#    - Supabase: Use Transaction mode URL (port 6543)
#
# 2. BACKEND_URL: Leave empty initially, set after first deployment
#
# 3. After adding all variables, deploy once, then update BACKEND_URL
#    with your actual Vercel domain and redeploy
