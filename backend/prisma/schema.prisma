generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      Role      @default(USER)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Bus {
  id         Int      @id @default(autoincrement())
  busNumber  String   @unique
  make       String?  // e.g., "Ashok Leyland", "Tata", "Volvo"
  model      String?  // e.g., "Viking", "Leyland", "B7R"
  seatLayout Json?    // Dynamic seat configuration (layout type, rows, columns, seat positions)
  totalSeats Int?     // Total number of seats
  seats      Seat[]
  schedules  Schedule[]
}

model Seat {
  id      Int     @id @default(autoincrement())
  seatNo  String
  busId   Int
  bus     Bus     @relation(fields: [busId], references: [id])
  bookings Booking[]
}

model Route {
  id        Int        @id @default(autoincrement())
  from      String
  to        String
  schedules Schedule[]
}

model Schedule {
  id           Int       @id @default(autoincrement())
  date         DateTime
  time         String
  busId        Int
  routeId      Int
  ticketPrice  Int       @default(2500) // Price per ticket in smallest currency unit (e.g., cents or paisa)

  bus          Bus     @relation(fields: [busId], references: [id])
  route        Route   @relation(fields: [routeId], references: [id])
  bookings     Booking[]
}

model Booking {
  id            Int       @id @default(autoincrement())
  bookingId     String?   @unique @default(uuid()) // Unique booking identifier for users (optional for migration)
  userId        Int
  seatId        Int
  scheduleId    Int
  passengerName String?   // Passenger name (can be different from user name) - optional for migration
  phoneNumber   String?   // Passenger phone number
  status        BookingStatus @default(CONFIRMED)
  cancellationStatus CancellationStatus? // Pending, Approved, or Rejected
  cancellationRequestedAt DateTime?
  cancellationApprovedAt DateTime?
  cancellationReason String?
  adminNotes    String?

  // PayHere Payment Fields
  paymentOrderId  String?   // PayHere order ID
  paymentStatus   PaymentStatus @default(UNPAID)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  seat      Seat     @relation(fields: [seatId], references: [id])
  schedule  Schedule @relation(fields: [scheduleId], references: [id])

  @@unique([seatId, scheduleId]) // prevents double booking
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}
